  <body>





<!--review-POPUP-->

<!-- Modal -->

<div id="review-modal" class="modal fade" role="dialog">

  <div class="modal-dialog review-pop">



    <!-- Modal content-->

    <div class="modal-content">



      <div class="modal-body">

      	<div class="row">

        	<div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 login-sec">

            	<img alt="image" src="https://aliento.com.au/wp-content/themes/web-aliento/images/review-icon.png" class="img-responsive center-block">

            	<h4>Customer Review Form</h4>

            </div>

            <div class="login-pop-btn">

            	<button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>

            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12 login-form">

            	<form id="myform" method="post">

                

                

                <div id="review-pop-msg" class="review-msg-popup" style="display:none;">

                	<h4>Thank you for submitting your review.</h4>

                </div>

                

                

                

        	<div class="row">

            	<div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">

                	<input id="fname" name="fname" type="text" placeholder="First Name" required >

                </div>

                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">

                	<input id="lname" name="lname" type="text" placeholder="Last Name" required>

                </div>

            </div>

             <div class="row">

            	<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

                	<input id="username" name="username" type="text" placeholder="Username (will be shown with review)">

                </div>

            </div>

            <div class="row">

            	<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

                	<input id="user_email" name="user_email" type="email" placeholder="Email" required>

                </div>

            </div>

            <div class="row">

            	<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

                	<textarea id="review" name="review" placeholder="Write A Review" rows="5"></textarea>

                </div>

            </div>

            <div class="row">

            	<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

                	 <fieldset class="rating"><p>Please Rate :</p>

                      <input type="radio" id="star5" name="rating" value="5" /><label class = "full" for="star5" title="Awesome - 5 stars"></label>

                      <input type="radio" id="star4half" name="rating" value="4 and a half" /><label class="half" for="star4half" title="Pretty good - 4.5 stars"></label>

                      <input type="radio" id="star4" name="rating" value="4" /><label class = "full" for="star4" title="Pretty good - 4 stars"></label>

                      <input type="radio" id="star3half" name="rating" value="3 and a half" /><label class="half" for="star3half" title="Meh - 3.5 stars"></label>

                      <input type="radio" id="star3" name="rating" value="3" /><label class = "full" for="star3" title="Meh - 3 stars"></label>

                      <input type="radio" id="star2half" name="rating" value="2 and a half" /><label class="half" for="star2half" title="Kinda bad - 2.5 stars"></label>

                      <input type="radio" id="star2" name="rating" value="2" /><label class = "full" for="star2" title="Kinda bad - 2 stars"></label>

